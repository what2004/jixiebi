<!-- 注意：本文件注释里不要出现 冒号加空格（例如 Version 后面跟冒号再跟空格再跟 1.6）。
     gazebo_ros2_control 会把整段 URDF 作为 robot_description 参数传给 controller_manager，
     rcl 解析器遇到 冒号加空格 会报 Couldn't parse parameter override rule，导致 controller_manager 无法启动。
     如果以后用 SolidWorks 重新导出，记得去掉注释里的冒号。 -->
<robot
  name="linkerhand_l20_right">
  <material name="silver">
    <color rgba="0.5 0.5 0.52 1.0"/>
  </material>

  <material name="BlackAccent">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="Red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

    <!-- ===== 方案A：把掌根固定到世界 =====
       原来 base_link 是自由基座，所有手指同时运动的反作用力会把整只手打飞。
       加一个 world link + 固定关节，把掌根焊在 spawn 的位置。 -->
  <link
    name="world"/>
  <joint
    name="fixed_base"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="world" />
    <child
      link="base_link" />
  </joint>




