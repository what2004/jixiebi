<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="linkerhand_l20_right">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import linkerhand_l20_right urdf file -->
    <xacro:include filename="$(find damuzhi_description)/urdf/hand.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="linkerhand_l20_right.ros2_control.xacro" />


    <xacro:linkerhand_l20_right_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
